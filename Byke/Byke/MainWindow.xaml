<Window x:Class="Byke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Byke"
        mc:Ignorable="d"
           Title="Вход" FontFamily="Arial" Background="White">
    <StackPanel Width="340" VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" Foreground="#4B0082"
                   HorizontalAlignment="Center" Margin="0,0,0,15"/>
        <TextBlock Text="Логин" Margin="4,0,0,0"/>
        <TextBox x:Name="txtLogin"/>
        <TextBlock Text="Пароль" Margin="4,8,0,0"/>
        <PasswordBox x:Name="txtPassword" Padding="4" Margin="4"/>
        <Button Content="Войти" IsDefault="True" Margin="4,16,4,4" Click="btnLogin_Click"/>
        <Button Content="Войти как гость" Background="#6A5ACD" Click="btnGuest_Click"/>
    </StackPanel>
</Window>
