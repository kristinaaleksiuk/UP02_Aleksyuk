<Page x:Class="Byke.Pages.OrderEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Byke.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
   Title="Заказ" FontFamily="Arial" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="600" Margin="0,15" HorizontalAlignment="Center">
            <TextBlock x:Name="txtHeader" FontSize="20" FontWeight="Bold" Foreground="#4B0082" Margin="4,0,0,10"/>

            <TextBlock Text="Пункт выдачи *" Margin="4,0,0,0"/>
            <ComboBox x:Name="cmbAddres" DisplayMemberPath="FullAddress" SelectedValuePath="Id"/>
            <TextBlock Text="Клиент *" Margin="4,4,0,0"/>
            <ComboBox x:Name="cmbUser" DisplayMemberPath="FIO" SelectedValuePath="Id"/>
            <TextBlock Text="Статус заказа *" Margin="4,4,0,0"/>
            <ComboBox x:Name="cmbStatus" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock Text="Дата заказа *" Margin="4,4,0,0"/>
            <DatePicker x:Name="dpOrderDate" Margin="4"/>
            <TextBlock Text="Дата доставки *" Margin="4,4,0,0"/>
            <DatePicker x:Name="dpDeliveryDate" Margin="4"/>
            <TextBlock Text="Код для получения *" Margin="4,4,0,0"/>
            <TextBox x:Name="txtCode"/>

            <TextBlock Text="Состав заказа *" FontWeight="Bold" Margin="4,12,0,4"/>
            <DataGrid x:Name="gridItems" AutoGenerateColumns="False" IsReadOnly="True" Height="140"
                      CanUserAddRows="False" SelectionMode="Single" Margin="4">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Артикул" Binding="{Binding Articyl}" Width="90"/>
                    <DataGridTextColumn Header="Наименование" Binding="{Binding NameTovar}" Width="*"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
            <Button Content="Удалить выбранную позицию" HorizontalAlignment="Left" Click="btnRemoveItem_Click"/>

            <TextBlock Text="Добавить товар" Margin="4,8,0,0"/>
            <ComboBox x:Name="cmbProduct" DisplayMemberPath="Title" SelectedValuePath="Articyl"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Количество:" VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBox x:Name="txtQty" Width="70" Text="1"/>
                <Button Content="Добавить в заказ" Click="btnAddItem_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Click="btnSave_Click"/>
                <Button Content="Отмена" Background="#6A5ACD" Click="btnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
