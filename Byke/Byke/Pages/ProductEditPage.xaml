<Page x:Class="Byke.Pages.ProductEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Byke.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" 
      Title="Товар" FontFamily="Arial" Background="White">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="560" Margin="0,15" HorizontalAlignment="Center">
            <TextBlock x:Name="txtHeader" FontSize="20" FontWeight="Bold" Foreground="#4B0082" Margin="4,0,0,10"/>

            <TextBlock Text="Артикул *" Margin="4,0,0,0"/>
            <TextBox x:Name="txtArticyl" MaxLength="10"/>
            <TextBlock Text="Наименование *" Margin="4,4,0,0"/>
            <TextBox x:Name="txtName" MaxLength="200"/>
            <TextBlock Text="Цена, ₽ *" Margin="4,4,0,0"/>
            <TextBox x:Name="txtPrice"/>
            <TextBlock Text="Поставщик *" Margin="4,4,0,0"/>
            <ComboBox x:Name="cmbSuploer" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock Text="Производитель *" Margin="4,4,0,0"/>
            <ComboBox x:Name="cmbManufacture" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock Text="Категория *" Margin="4,4,0,0"/>
            <ComboBox x:Name="cmbCategory" DisplayMemberPath="Name" SelectedValuePath="Id"/>
            <TextBlock Text="Скидка, % (0-100) *" Margin="4,4,0,0"/>
            <TextBox x:Name="txtDiscount"/>
            <TextBlock Text="Количество на складе *" Margin="4,4,0,0"/>
            <TextBox x:Name="txtQuluety"/>
            <TextBlock Text="Описание" Margin="4,4,0,0"/>
            <TextBox x:Name="txtDiscription" Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Фото" Margin="4,4,0,0"/>
            <StackPanel Orientation="Horizontal">
                <Image x:Name="imgPhoto" Width="120" Height="90" Stretch="Uniform" Margin="4"/>
                <Button Content="Выбрать фото" VerticalAlignment="Center" Click="btnPhoto_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Content="Сохранить" Click="btnSave_Click"/>
                <Button Content="Отмена" Background="#6A5ACD" Click="btnCancel_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
