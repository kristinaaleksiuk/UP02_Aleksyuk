<Page x:Class="Byke.Pages.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Byke.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
    Title="Заказы" FontFamily="Arial" Background="White" Loaded="Page_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,8">
            <Button x:Name="btnAdd" Content="Добавить заказ" Click="btnAdd_Click"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="lstOrders">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#6A5ACD" BorderThickness="1" Margin="10,5" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding OrderId, StringFormat=Заказ № {0}}" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock Text="{Binding Composition, StringFormat=Артикул заказа: {0}}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StatusName, StringFormat=Статус заказа: {0}}"/>
                                    <TextBlock Text="{Binding AddressText, StringFormat=Адрес пункта выдачи: {0}}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OrderDate, StringFormat=Дата заказа: {0:dd.MM.yyyy}}"/>
                                    <TextBlock Text="{Binding ClientFio, StringFormat=Клиент: {0}}"/>
                                    <TextBlock Text="{Binding Code, StringFormat=Код для получения: {0}}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="Дата доставки" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}" FontWeight="Bold"
                                               FontSize="16" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding TotalCost, StringFormat=Сумма: {0:N2} ₽}" HorizontalAlignment="Right" Margin="0,4"/>
                                    <Button Content="Редактировать" Click="btnEdit_Click"
                                            Visibility="{Binding Source={x:Static app:Session.AdminVisibility}}"/>
                                    <Button Content="Удалить" Click="btnDelete_Click"
                                            Visibility="{Binding Source={x:Static app:Session.AdminVisibility}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
